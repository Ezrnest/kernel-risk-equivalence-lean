import KernelSeq.RKHSConditionalRisk
import KernelSeq.RHSFluctuation

/-!
# Integrating sampled target squares on leave-one-out events

The sigma-algebra generated by every other full observation is independent of
the omitted observation. This proves the exact factorization used to control
bad-design loss without any fourth-moment assumption on the target.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped BigOperators

namespace KernelSeq

variable {Ω X : Type*} [MeasurableSpace Ω] [MeasurableSpace X]
  {P : Measure Ω} {μ : Measure X}

/-- The actual sampled target square has the population L2 norm as its mean. -/
theorem integral_sample_lpRepresentative_sq {n : ℕ} (Z : Fin n → Ω → X × ℝ)
    (hlaw : ∀ i, MeasurePreserving (fun ω => (Z i ω).1) P μ)
    (f : Lp ℝ 2 μ) (i : Fin n) :
    (∫ ω, lpRepresentative f ((Z i ω).1) ^ 2 ∂P) = ‖f‖ ^ 2 := by
  have hpull := integral_map (hlaw i).aemeasurable
    (show AEStronglyMeasurable (fun x => lpRepresentative f x ^ 2)
      (Measure.map (fun ω => (Z i ω).1) P) by
        rw [(hlaw i).map_eq]
        exact (lpRepresentative_stronglyMeasurable f).pow 2 |>.aestronglyMeasurable)
  rw [(hlaw i).map_eq] at hpull
  calc
    _ = ∫ x, lpRepresentative f x ^ 2 ∂μ := hpull.symm
    _ = ∫ x, f x ^ 2 ∂μ := integral_congr_ae ((lpRepresentative_ae_eq f).fun_comp (· ^ 2))
    _ = _ := integral_sq_L2 f

/-- Exact leave-one-out factorization for the genuine L2 target. -/
theorem integral_sample_lpRepresentative_sq_on_rest {n : ℕ}
    (Z : Fin n → Ω → X × ℝ) (hZ : ∀ i, Measurable (Z i))
    (hlaw : ∀ i, MeasurePreserving (fun ω => (Z i ω).1) P μ)
    (hind : iIndepFun Z P) (f : Lp ℝ 2 μ) (i : Fin n) {B : Set Ω}
    (hB : MeasurableSet[⨆ j, ⨆ (_ : j ≠ i), observationPairSigma (Z j)] B) :
    (∫ ω in B, lpRepresentative f ((Z i ω).1) ^ 2 ∂P) = ‖f‖ ^ 2 * P.real B := by
  have hm (j : Fin n) : observationPairSigma (Z j) ≤ (inferInstance : MeasurableSpace Ω) :=
    (hZ j).comap_le
  have hrest : (⨆ j, ⨆ (_ : j ≠ i), observationPairSigma (Z j)) ≤
      (inferInstance : MeasurableSpace Ω) := iSup_le fun j => iSup_le fun _ => hm j
  have hown : Measurable[observationPairSigma (Z i)] (Z i) :=
    Measurable.of_comap_le le_rfl
  have hfun : StronglyMeasurable[observationPairSigma (Z i)]
      (fun ω => lpRepresentative f ((Z i ω).1) ^ 2) :=
    ((lpRepresentative_measurable f).comp hown.fst).pow_const 2 |>.stronglyMeasurable
  have h := independent_setIntegral_inter (hm i) hrest
    (independent_block_rest hm hind.iIndep i) _ hfun MeasurableSet.univ hB
  simpa only [Set.univ_inter, integral_sample_lpRepresentative_sq Z hlaw f i,
    setIntegral_univ] using h

/-- The sum of actual sampled target squares on the bad event is bounded by
the leave-one-out probability times its exact mean. Only structural event
containment and the displayed numerical probability bounds are inputs here. -/
theorem integral_sample_target_sq_bad_le {n : ℕ}
    (Z : Fin n → Ω → X × ℝ) (hZ : ∀ i, Measurable (Z i))
    (hlaw : ∀ i, MeasurePreserving (fun ω => (Z i ω).1) P μ)
    (hind : iIndepFun Z P) (f : Lp ℝ 2 μ) (B : Set Ω) (Bi : Fin n → Set Ω)
    (hBi : ∀ i, MeasurableSet[⨆ j, ⨆ (_ : j ≠ i), observationPairSigma (Z j)] (Bi i))
    (hsub : ∀ i, B ≤ᵐ[P] Bi i) {p : ℝ} (hprob : ∀ i, P.real (Bi i) ≤ p) :
    (∫ ω in B, ∑ i, lpRepresentative f ((Z i ω).1) ^ 2 ∂P) ≤
      (n : ℝ) * ‖f‖ ^ 2 * p := by
  classical
  have hi (i : Fin n) : Integrable (fun ω => lpRepresentative f ((Z i ω).1) ^ 2) P :=
    ((lpRepresentative_memLp f).comp_measurePreserving (hlaw i)).integrable_sq
  rw [integral_finsetSum _ (fun i _ => (hi i).integrableOn)]
  calc
    _ ≤ ∑ i : Fin n, ‖f‖ ^ 2 * p := by
      apply Finset.sum_le_sum
      intro i _
      calc
        _ ≤ ∫ ω in Bi i, lpRepresentative f ((Z i ω).1) ^ 2 ∂P :=
          setIntegral_mono_set (hi i).integrableOn
            (Eventually.of_forall fun _ => sq_nonneg _) (hsub i)
        _ = ‖f‖ ^ 2 * P.real (Bi i) :=
          integral_sample_lpRepresentative_sq_on_rest Z hZ hlaw hind f i (hBi i)
        _ ≤ _ := mul_le_mul_of_nonneg_left (hprob i) (sq_nonneg _)
    _ = _ := by simp [mul_assoc]

end KernelSeq
